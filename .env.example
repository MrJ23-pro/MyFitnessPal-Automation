# 2captcha API key for automatic reCAPTCHA resolution
# Get from: https://2captcha.com/api/user
TWOCAPTCHA_KEY=

# reCAPTCHA site key (found in website source code)
# This is the public key, safe to commit if already visible in HTML
RECAPTCHA_KEY=

# Promo code to test
PROMO_CODE=PCS

# HTTP proxy URL (optional)
# Format: http://user:pass@proxy.com:port or http://proxy.com:8080
PROXY=

# Max daily bandwidth limit in MB (0 = unlimited)
MAX_DAILY_MB=15.0

# reCAPTCHA resolution timeout in seconds
CAPTCHA_TIMEOUT=90

# Auto-resolve captcha (true/false)
AUTO_CAPTCHA=false

# Form submission mode (skip-captcha, auto-captcha, or manual)
SUBMISSION_MODE=auto-captcha
